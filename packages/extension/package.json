{
  "name": "dust",
  "displayName": "dust",
  "version": "0.1.0",
  "description": "Apply an actor over a selected file or folder from the Explorer.",
  "publisher": "dust",
  "license": "MIT",
  "engines": {
    "vscode": "^1.90.0"
  },
  "activationEvents": [
    "onCommand:dust.open"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "commands": [
      {
        "command": "dust.open",
        "title": "Apply Dust Actor…"
      }
    ],
    "menus": {
      "explorer/context": [
        {
          "command": "dust.open",
          "when": "resourceScheme == file",
          "group": "navigation"
        }
      ]
    }
  },
  "files": [
    "dist",
    "assets"
  ],
  "scripts": {
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./",
    "build:host": "esbuild src/extension.ts --bundle --platform=node --format=cjs --outfile=dist/extension.js --external:vscode --external:better-sqlite3",
    "build:webview": "esbuild src/webview/index.tsx --bundle --outdir=dist/webview --external:vscode --external:os --external:path",
    "vscode:prepublish": "npm run compile && npm run build:host && npm run build:webview",
    "test": "npm run compile && node --test \"dist/**/*.test.js\"",
    "package": "vsce package --no-dependencies --allow-missing-repository --skip-license"
  },
  "dependencies": {
    "@dust/shared": "^0.1.0",
    "better-sqlite3": "^13.0.2"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/node": "^20.0.0",
    "@types/vscode": "^1.90.0",
    "@vscode/vsce": "^3.2.0",
    "esbuild": "^0.20.2",
    "preact": "^10.19.0",
    "typescript": "^5.4.0"
  }
}
